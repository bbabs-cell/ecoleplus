# Projet Supabase — Settings > API du tableau de bord Supabase.
# Ces deux valeurs sont publiques par nature : elles partent au navigateur.
# C'est RLS qui protège les données, jamais le secret de la clé.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Ne JAMAIS exposer la service_role key ici, ni dans aucune variable
# NEXT_PUBLIC_* : elle contourne RLS et donnerait accès à tous les tenants.

# Cloudflare R2 — stockage des documents. Bucket PRIVÉ : aucune de ces valeurs
# ne doit apparaître dans une variable NEXT_PUBLIC_*, le navigateur ne reçoit
# que des URL signées de courte durée.
# Tableau de bord Cloudflare > R2 > Manage API Tokens.
R2_ACCOUNT_ID=votre-identifiant-de-compte
R2_ACCESS_KEY_ID=votre-cle-d-acces
R2_SECRET_ACCESS_KEY=votre-cle-secrete
R2_BUCKET=ecoleplus-documents
