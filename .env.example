# Projet Supabase — Settings > API du tableau de bord Supabase.
# Ces deux valeurs sont publiques par nature : elles partent au navigateur.
# C'est RLS qui protège les données, jamais le secret de la clé.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Ne JAMAIS exposer la service_role key ici, ni dans aucune variable
# NEXT_PUBLIC_* : elle contourne RLS et donnerait accès à tous les tenants.
